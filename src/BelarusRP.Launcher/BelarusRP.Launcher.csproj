<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>BelarusRP.Launcher</RootNamespace>
    <AssemblyName>BelarusRP</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>Belarus RP Launcher</Product>
    <Company>Belarus RP</Company>
    <!-- Версия. В релизе её переопределяет тег (v1.0.1 -> 1.0.1), см. .github/workflows/release.yml -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('Resources\app.ico')">
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Шифрование данных (DPAPI) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Конфиг вшивается в exe, чтобы лаунчер работал одним файлом -->
    <EmbeddedResource Include="..\..\config\launcher.config.json" LogicalName="launcher.config.json" />
  </ItemGroup>

</Project>
